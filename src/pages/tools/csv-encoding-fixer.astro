---
import ToolLayout, { type FaqItem } from '../../layouts/ToolLayout.astro'
import CsvEncodingFixer from '../../components/tools/CsvEncodingFixer'
import { getToolBySlug } from '../../data/tools'

const tool = getToolBySlug('csv-encoding-fixer')
const seoTitle = 'Excel CSV文字化け修復(UTF-8 BOM付)＆列マスキング | LocalBox'
const seoDescription =
  'CSVファイルをサーバーへ送信せずブラウザ内だけで文字コードを自動判定し、Excelで文字化けしないUTF-8(BOM付)やShift-JISへ変換。氏名・メール等の列マスクや削除も可能です。'

const faqs: FaqItem[] = [
  {
    question: 'なぜBOMなしのUTF-8 CSVをExcelでダブルクリックすると文字化けするのですか？',
    answer:
      'Windows版のMicrosoft Excelは、CSVファイルの先頭にBOM（Byte Order Mark：0xEF 0xBB 0xBF）が付いていない場合、ファイルを従来のShift-JIS（CP932）とみなして開く挙動があるためです。本ツールで「UTF-8 (BOM付・Excel最適)」を選んで変換すると、MacでもWindows Excelでも文字化けせず正常に表示されます。',
  },
  {
    question: '顧客名簿や売上明細を含むCSVをブラウザで読み込んでも外部に漏れませんか？',
    answer:
      'はい、100%安全です。HTML5のFile APIを使ってお使いの端末メモリ上でバイト配列を直接変換しており、ファイルの中身がネットワークを経由して当サイトや第三者のサーバーへアップロードされることはありません。',
  },
  {
    question: '「列マスク」や「列削除」機能はどんな用途に向いていますか？',
    answer:
      '経理データやアンケート結果を外部パートナーへ共有する前や、生成AIにデータ分析を依頼する直前に、「氏名」「メールアドレス」「電話番号」といった個人情報列だけをボタン一つで「***」に置換したり丸ごと列ごと削ぎ落としたりする用途に最適です。',
  },
  {
    question: 'Shift-JISに変換し直したファイルが「?」に変わってしまう漢字はありますか？',
    answer:
      'UTF-8には含まれるもののShift-JISの文字集合に存在しない特殊記号、環境依存文字、絵文字、一部の旧字体・異体字は、Shift-JISへの変換時に表現できず置換される場合があります。特別な事情がなければ互換性と文字表現力の高い「UTF-8 (BOM付)」形式での保存をおすすめします。',
  },
]
---

<ToolLayout
  tool={tool}
  seoTitle={seoTitle}
  seoDescription={seoDescription}
  featureList={[
    'Shift-JIS・UTF-8(BOM有無)・EUC-JP・JIS・UTF-16の文字コード自動判定と手動切替',
    'Excelで文字化けしないUTF-8 BOM付きCSVへのローカル変換・書き出し',
    'RFC-4180準拠のセル内改行・ダブルクォート対応パーサー',
    '列ごとの個人情報マスク（***）および不要列削除機能・JSON変換',
  ]}
  faqs={faqs}
>
  <CsvEncodingFixer slot="tool" client:load />

  <div slot="guide" class="space-y-4 text-sm leading-relaxed text-slate-700">
    <section>
      <h2 class="text-lg font-bold text-slate-900">
        ExcelでCSVが「驟｡螟峨↑」と文字化けする本当の理由と一番確実な解決策
      </h2>
      <p class="mt-2.5">
        Webサービス、SaaS管理画面、ECショップ、決済システムからダウンロードしたCSVファイルをWindowsのExcelで開いた瞬間、日本語が意味不明な漢字の羅列に化けてしまう現象は、日本のオフィス実務における定番トラブルの一つです。これはデータが壊れているわけではなく、出力側のシステムが「UTF-8（BOMなし）」で書き出したファイルを、Excel側が「Shift-JIS」だと誤解して読み込む文字コードのすれ違いによって起きます。
      </p>
      <p class="mt-2.5">
        従来の対処法では、メモ帳やテキストエディタで一度開いて「名前を付けて保存」をやり直したり、Excelのデータタブから毎回インポートウィザードを起動したりと面倒な手順が必要でした。本ツールを使えば、ファイルをドラッグまたは選択するだけでブラウザがバイト列から文字コードを自動判別し、1クリックでExcelがそのまま正しく開ける「UTF-8（BOM付）」へ作り直せます。
      </p>
    </section>

    <details class="group rounded-xl border border-slate-200 bg-slate-50/50">
      <summary class="flex cursor-pointer list-none items-center justify-between gap-3 px-4 py-3 text-base font-bold text-slate-900">
        <span>変換ついでに個人情報を伏せられる「列マスキング＆列削除」の実務価値</span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="shrink-0 text-slate-400 transition-transform duration-200 group-open:rotate-180">
          <path d="m6 9 6 6 6-6" />
        </svg>
      </summary>
      <div class="space-y-3 border-t border-slate-200 px-4 py-4">
        <p>
          日本の多くの企業では、「顧客一覧・注文履歴・社員名簿が含まれるCSVをオンラインの無料変換サイトへアップロードすること」自体が情報セキュリティ規定で禁止されています。なぜなら、通常のWeb変換ツールはサーバーへファイルを送信して処理するため、いつどこにファイルがキャッシュされるか分からないからです。
        </p>
        <p>
          LocalBoxのCSV修復ツールは<strong>完全ローカル処理</strong>であることに加え、プレビューを確認しながら列ごとに<strong>「そのまま」「マスク (***)」「列を削除」</strong>を指定できる機能を搭載しました。例えば、AIツールに売上データの傾向分析を任せたい時、「顧客名」と「メールアドレス」の列だけをローカルでマスクまたは削除してから出力すれば、分析に必要な数値や商品カテゴリを保ったまま安全にデータ活用へ進めます。
        </p>
      </div>
    </details>

    <details class="group rounded-xl border border-slate-200 bg-slate-50/50">
      <summary class="flex cursor-pointer list-none items-center justify-between gap-3 px-4 py-3 text-base font-bold text-slate-900">
        <span>セル内改行やカンマを含む複雑なCSVでも崩れないパース処理</span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="shrink-0 text-slate-400 transition-transform duration-200 group-open:rotate-180">
          <path d="m6 9 6 6 6-6" />
        </svg>
      </summary>
      <div class="border-t border-slate-200 px-4 py-4">
        <p>
          単純にテキストを改行やカンマで分割する簡易スクリプトでは、アンケートの自由記述欄に含まれる「セル内の改行」や「金額の3桁カンマ区切り」で行がズレてしまい、データが破損します。本ツールはRFC-4180準拠のステートマシンパーサーを採用しているため、ダブルクォートで囲まれたフィールド内の改行やカンマ、エスケープされた引用符も正確に解釈した上で安全に再出力します。
        </p>
      </div>
    </details>
  </div>
</ToolLayout>
