---
import ToolLayout, { type FaqItem } from '../../layouts/ToolLayout.astro'
import ImageExifCleaner from '../../components/tools/ImageExifCleaner'
import { getToolBySlug } from '../../data/tools'

const tool = getToolBySlug('image-exif-cleaner')
const seoTitle = '画像EXIF/GPS位置情報 完全削除＆WebP/JPG軽量化 | LocalBox'
const seoDescription =
  '写真に含まれるGPS緯度経度・撮影日時・カメラ機種などのEXIFメタデータをサーバーへ送らずブラウザのCanvas再描画で物理削除。WebP・JPEG・PNGへの一括軽量化にも対応。'

const faqs: FaqItem[] = [
  {
    question: '画像に含まれるEXIFやGPS情報を消さないまま公開するとどのような危険がありますか？',
    answer:
      'スマートフォンやデジタルカメラで撮影したJPEG写真には、撮影場所の緯度経度（GPS座標）、撮影日時、使用機種、レンズ設定などのEXIF情報が埋め込まれていることがあります。SNSの多くは投稿時に自動で削除しますが、個人ブログ、社内共有フォルダ、メール添付、フリマアプリ外の独自フォームなどではそのまま公開され、自宅や勤務先が特定されるリスクがあります。',
  },
  {
    question: 'Canvas再描画による削除は本当にすべてのメタデータを消せますか？',
    answer:
      'はい。EXIF・IPTC・XMP・コメント領域などJPEGやPNGの付加チャンクを一つずつ解析して書き換える方式と異なり、ブラウザのHTML5 Canvas上へ「純粋なピクセル画像情報のみ」を再描画し直してから新しい画像バイナリを生成するため、GPSや端末情報などのメタデータ領域は構造上100%引き継がれません。処理後の画像も本ツール自身がバイナリ再検査して0件であることを表示します。',
  },
  {
    question: 'WebP・JPEG・PNGの出力フォーマットはどう使い分ければいいですか？',
    answer:
      'ブログ記事やWebサイトへ掲載して表示速度・SEOを重視する場合は、画質を保ったまま大幅に容量を減らせる「WebP」が最適です。メール添付や古い業務システムへの提出など互換性最優先の場合は「JPEG」、スクリーンショットや図表の境界をくっきり保ちたい場合は「PNG」をお選びください。',
  },
  {
    question: 'スマホで撮った縦向き写真が横向きに回転してしまうことはありますか？',
    answer:
      'モダンブラウザのImageデコードおよびCanvas描画はEXIFのOrientation（回転情報）を解釈した正しい向きでピクセルを描き出すため、向きの見た目を引き継いだままEXIF情報だけを取り除いた正常な画像を生成できます。',
  },
]
---

<ToolLayout
  tool={tool}
  seoTitle={seoTitle}
  seoDescription={seoDescription}
  featureList={[
    'JPEG APP1(EXIF/GPS/XMP)・IPTC・PNGテキストチャンクのローカル事前診断',
    'HTML5 Canvas再描画によるメタデータの物理的完全除去',
    '処理後バイナリの自動再検査による残存タグ0件証明',
    'WebP / JPEG / PNG 一括変換・品質調整・最大幅リサイズ',
  ]}
  faqs={faqs}
>
  <ImageExifCleaner slot="tool" client:load />

  <div slot="guide" class="space-y-6 text-sm leading-relaxed text-slate-700">
    <section>
      <h2 class="text-xl font-bold text-slate-900">
        「画像ファイルに隠れた位置情報」を誰のサーバーにも預けず確実に消す
      </h2>
      <p class="mt-3">
        自宅の作業デスク、子どもの作品、職場のホワイトボード、外出先でのメモをスマートフォンで撮影し、ブログやドキュメント、チャットへ貼り付ける機会は日常的です。しかし撮影直後の画像ファイルには、目に見える写真データとは別に、撮影時刻・GPS座標（数メートル単位の誤差で自宅位置がわかることもあります）・端末名・ソフトウェア名といったメタデータが記録されています。
      </p>
      <p class="mt-3">
        プライバシーを守るために「EXIF削除サイト」を使う際、もしそのサイトが画像ファイルをクラウドサーバーへ送信する仕組みだった場合、位置情報入りの元画像を一度外部へ渡してしまうという本末転倒な状態になります。LocalBoxの画像EXIF削除ツールは、ファイルの読み取りから検査、再描画、ダウンロード用ファイル生成までをすべてブラウザ内で完結させるため、プライベートの写真も社外秘の撮影画像も外部に流れません。
      </p>
    </section>

    <section>
      <h2 class="text-xl font-bold text-slate-900">
        削除前バイナリ診断と削除後再チェックの仕組み
      </h2>
      <p class="mt-3">
        本ツールに画像を読み込ませると、まず純粋なTypeScript製のバイナリ検査エンジンが先頭ヘッダーを走査します。JPEGであれば <code>0xFFE1</code>（APP1領域）内の <code>Exif</code> タグやGPS IFDポインタ（<code>0x8825</code>）、Adobe XMP、IPTC、コメントチャンクを検出し、PNGであれば <code>eXIf</code> やテキストメタデータ（<code>tEXt</code> / <code>iTXt</code> / <code>tIME</code>）を特定します。
      </p>
      <p class="mt-3">
        その後、HTML5 Canvasへピクセルだけを再描画して新しい画像バイナリを作成し、完成したバイナリに対しても同じ検査エンジンをもう一度走らせます。各カードの「削除後再検査: 検出 0 件」という表示は飾りではなく、実際に出力ファイルのバイナリを確認した結果です。
      </p>
    </section>

    <section>
      <h2 class="text-xl font-bold text-slate-900">
        メタデータ削除と同時にWebP軽量化・リサイズまで一括完了
      </h2>
      <p class="mt-3">
        最近のスマートフォンカメラで撮影した写真は横幅が4,000pxを超え、ファイルサイズも1枚3〜6MBに達することが珍しくありません。そのまま資料やWebサイトに貼り付けると読み込みが重くなる原因になります。本ツールではEXIF削除の工程とあわせて最大横幅（1920px / 1280px / 800px）の縮小と高効率なWebP形式への変換を同時に行えるため、安全確保とページ高速化を一度の作業で終えられます。
      </p>
    </section>
  </div>
</ToolLayout>
