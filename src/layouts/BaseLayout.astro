---
import '../styles/global.css'
import { LEGAL_LINKS, SITE_CONFIG } from '../config/site'
import { PUBLISHED_TOOLS } from '../data/tools'
import { getAppVersionInfo } from '../lib/app-version'

interface Props {
  title: string
  description: string
  canonicalPath?: string
  jsonLd?: Record<string, unknown> | Record<string, unknown>[]
  noindex?: boolean
}

const {
  title,
  description,
  canonicalPath,
  jsonLd,
  noindex = false,
} = Astro.props

const siteOrigin = Astro.site?.href || SITE_CONFIG.defaultUrl
const canonicalUrl = new URL(canonicalPath ?? Astro.url.pathname, siteOrigin).href
const ldList = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : []
const gaId = SITE_CONFIG.gaMeasurementId
const adsenseClient = SITE_CONFIG.adsenseClientId
const appVersion = getAppVersionInfo()
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="app-version" content={appVersion.metaContent} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_CONFIG.brandName} />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    {
      ldList.map((entry) => (
        <script is:inline type="application/ld+json" set:html={JSON.stringify(entry)} />
      ))
    }

    {
      gaId && (
        <>
          <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`} />
          <script is:inline define:vars={{ gaId }}>
            window.dataLayer = window.dataLayer || [];
            function gtag() {
              window.dataLayer.push(arguments);
            }
            gtag('js', new Date());
            gtag('config', gaId);
          </script>
        </>
      )
    }

    {
      adsenseClient && (
        <script
          async
          src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adsenseClient}`}
          crossorigin="anonymous"
        />
      )
    }
  </head>
  <body class="flex min-h-screen flex-col bg-slate-50 text-slate-900 antialiased">
    <header class="sticky top-0 z-30 border-b border-slate-200/80 bg-white/95 backdrop-blur">
      <div class="mx-auto flex h-14 max-w-6xl items-center justify-between gap-3 px-4 sm:px-6">
        <a
          href="/"
          class="flex shrink-0 items-center gap-2 text-slate-900 no-underline transition-opacity hover:opacity-80"
        >
          <svg
            width="28"
            height="28"
            viewBox="0 0 64 64"
            fill="none"
            aria-hidden="true"
            class="shrink-0"
          >
            <rect width="64" height="64" rx="16" fill="#0F172A" />
            <rect
              x="12"
              y="14"
              width="40"
              height="36"
              rx="8"
              stroke="#38BDF8"
              stroke-width="3.5"
            />
            <path
              d="M22 29L29 36L42 23"
              stroke="#34D399"
              stroke-width="4"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
            <circle cx="48" cy="18" r="4" fill="#38BDF8" />
          </svg>
          <span class="text-base font-bold tracking-tight text-slate-900">
            {SITE_CONFIG.brandName}
          </span>
        </a>

        <nav
          aria-label="メインナビゲーション"
          class="flex items-center gap-x-3.5 text-xs font-medium text-slate-600 sm:gap-x-6 sm:text-sm"
        >
          <a href="/#tools" class="whitespace-nowrap transition-colors hover:text-slate-900">
            ツール一覧
          </a>
          <a href="/about/" class="whitespace-nowrap transition-colors hover:text-slate-900">
            仕組み
          </a>
          <a href="/privacy/" class="whitespace-nowrap transition-colors hover:text-slate-900">
            プライバシー
          </a>
          <a href="/contact/" class="whitespace-nowrap transition-colors hover:text-slate-900">
            お問い合わせ
          </a>
        </nav>
      </div>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="border-t border-slate-200 bg-white">
      <div class="mx-auto max-w-6xl px-4 py-8 sm:px-6">
        <div class="grid gap-6 md:grid-cols-[1.2fr_1fr_1fr]">
          <div>
            <p class="text-sm font-bold text-slate-900">{SITE_CONFIG.brandName}</p>
            <p class="mt-1.5 text-xs leading-relaxed text-slate-600">
              すべての処理をブラウザ内だけで完結させ、サーバーへのデータ送信を行わない実務向け無料ツール集です。
            </p>
          </div>

          <div>
            <p class="text-xs font-bold tracking-wide text-slate-900">ツール</p>
            <ul class="mt-2.5 space-y-1.5 text-xs text-slate-600">
              {
                PUBLISHED_TOOLS.map((tool) => (
                  <li>
                    <a
                      href={`/tools/${tool.slug}/`}
                      class="transition-colors hover:text-sky-700 hover:underline"
                    >
                      {tool.shortTitle}
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>

          <div>
            <p class="text-xs font-bold tracking-wide text-slate-900">情報・ポリシー</p>
            <ul class="mt-2.5 space-y-1.5 text-xs text-slate-600">
              {
                LEGAL_LINKS.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      class="transition-colors hover:text-sky-700 hover:underline"
                    >
                      {link.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>

        <div class="mt-6 flex flex-wrap items-center justify-between gap-2 border-t border-slate-100 pt-5 text-[11px] text-slate-500">
          <p>&copy; 2026 {SITE_CONFIG.brandName}. 処理はすべてローカルブラウザ上で実行されます。</p>
          <span
            data-testid="app-version"
            title={appVersion.builtAt ? `Build: ${appVersion.builtAt}` : undefined}
            class="font-mono text-[11px] text-slate-400"
          >
            {appVersion.displayLabel}
          </span>
        </div>
      </div>
    </footer>
  </body>
</html>
