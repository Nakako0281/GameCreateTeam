---
import BaseLayout from './BaseLayout.astro'
import PhraseHeading from '../components/PhraseHeading.astro'
import { SITE_CONFIG } from '../config/site'
import { getRelatedPublishedTools, type ToolDefinition } from '../data/tools'

export interface FaqItem {
  question: string
  answer: string
}

interface Props {
  tool: ToolDefinition
  seoTitle: string
  seoDescription: string
  featureList: string[]
  faqs: FaqItem[]
}

const { tool, seoTitle, seoDescription, featureList, faqs } = Astro.props

const siteOrigin = Astro.site?.href || SITE_CONFIG.defaultUrl
const toolUrl = new URL(`/tools/${tool.slug}/`, siteOrigin).href
const homeUrl = new URL('/', siteOrigin).href
const relatedTools = getRelatedPublishedTools(tool.slug)

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: tool.name,
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'Web Browser (Client-Side Only)',
    url: toolUrl,
    description: seoDescription,
    inLanguage: 'ja',
    isAccessibleForFree: true,
    featureList,
    offers: {
      '@type': 'Offer',
      price: '0',
      priceCurrency: 'JPY',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'ホーム',
        item: homeUrl,
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: tool.shortTitle,
        item: toolUrl,
      },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: faq.answer,
      },
    })),
  },
]
---

<BaseLayout title={seoTitle} description={seoDescription} jsonLd={jsonLd}>
  <div class="mx-auto max-w-5xl px-4 py-6 sm:px-6 sm:py-8">
    <div class="flex flex-wrap items-center justify-between gap-2 text-xs text-slate-500">
      <nav aria-label="パンくずリスト" class="flex items-center gap-1.5 font-medium">
        <a href="/" class="hover:text-sky-700 hover:underline">ホーム</a>
        <span aria-hidden="true">/</span>
        <span class="text-slate-800">{tool.shortTitle}</span>
      </nav>

      <span class="inline-flex items-center gap-1.5 font-medium text-emerald-700">
        <span class="h-1.5 w-1.5 rounded-full bg-emerald-500" aria-hidden="true"></span>
        ブラウザ完結・外部送信なし
      </span>
    </div>

    <header class="mt-2.5 mb-5">
      <PhraseHeading
        as="h1"
        segments={tool.titleSegments}
        class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl"
      />
      <p class="mt-1.5 text-sm leading-relaxed text-slate-600">
        {tool.shortSummary}
      </p>
    </header>

    <section
      aria-label="ツール操作パネル"
      class="rounded-2xl border border-slate-200 bg-white p-4 shadow-xs sm:p-6"
    >
      <slot name="tool" />
      <p class="mt-5 border-t border-slate-100 pt-3 text-[11px] leading-relaxed text-slate-500">
        すべての処理はブラウザ内のみで実行され、入力内容がサーバーへ送信されることはありません。業務利用や送信前には出力結果をご自身で確認してください。
      </p>
    </section>

    <article class="mt-12 space-y-6 rounded-2xl border border-slate-200/80 bg-white/85 p-5 sm:p-8">
      <slot name="guide" />

      <section aria-labelledby="faq-heading" class="border-t border-slate-200 pt-6">
        <h2 id="faq-heading" class="text-lg font-bold text-slate-900">
          よくある質問
        </h2>
        <div class="mt-3 divide-y divide-slate-200 rounded-xl border border-slate-200 bg-slate-50/50">
          {
            faqs.map((faq, idx) => (
              <details class="group p-4" open={idx === 0}>
                <summary class="flex cursor-pointer list-none items-center justify-between gap-3 text-sm font-bold text-slate-900">
                  <span>{faq.question}</span>
                  <svg
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                    class="shrink-0 text-slate-400 transition-transform duration-200 group-open:rotate-180"
                  >
                    <path d="m6 9 6 6 6-6" />
                  </svg>
                </summary>
                <p class="mt-2.5 text-sm leading-relaxed text-slate-700">
                  {faq.answer}
                </p>
              </details>
            ))
          }
        </div>
      </section>
    </article>

    {
      relatedTools.length > 0 && (
        <section aria-labelledby="related-tools-heading" class="mt-10">
          <h2 id="related-tools-heading" class="text-base font-bold text-slate-900">
            その他のローカルツール
          </h2>
          <div class="mt-3 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
            {relatedTools.map((rel) => (
              <a
                href={`/tools/${rel.slug}/`}
                class="group rounded-xl border border-slate-200 bg-white p-4 transition hover:border-sky-300 hover:shadow-xs"
              >
                <span class="text-[11px] font-semibold text-sky-700">
                  {rel.categoryLabel}
                </span>
                <h3 class="mt-1 text-sm font-bold text-slate-900 group-hover:text-sky-700">
                  {rel.shortTitle}
                </h3>
                <p class="mt-1 text-xs leading-relaxed text-slate-600">
                  {rel.shortSummary}
                </p>
              </a>
            ))}
          </div>
        </section>
      )
    }
  </div>
</BaseLayout>
