---
import BaseLayout from './BaseLayout.astro'
import { SITE_CONFIG } from '../config/site'
import { getRelatedPublishedTools, type ToolDefinition } from '../data/tools'

export interface FaqItem {
  question: string
  answer: string
}

interface Props {
  tool: ToolDefinition
  seoTitle: string
  seoDescription: string
  featureList: string[]
  faqs: FaqItem[]
}

const { tool, seoTitle, seoDescription, featureList, faqs } = Astro.props

const siteOrigin = Astro.site?.href || SITE_CONFIG.defaultUrl
const toolUrl = new URL(`/tools/${tool.slug}/`, siteOrigin).href
const homeUrl = new URL('/', siteOrigin).href
const relatedTools = getRelatedPublishedTools(tool.slug)

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: tool.name,
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'Web Browser (Client-Side Only)',
    url: toolUrl,
    description: seoDescription,
    inLanguage: 'ja',
    isAccessibleForFree: true,
    featureList,
    offers: {
      '@type': 'Offer',
      price: '0',
      priceCurrency: 'JPY',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'ホーム',
        item: homeUrl,
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: tool.shortTitle,
        item: toolUrl,
      },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: faq.answer,
      },
    })),
  },
]
---

<BaseLayout title={seoTitle} description={seoDescription} jsonLd={jsonLd}>
  <div class="mx-auto max-w-5xl px-4 py-8 sm:px-6">
    <nav aria-label="パンくずリスト" class="mb-4 flex flex-wrap items-center gap-2 text-xs font-medium text-slate-600">
      <a href="/" class="hover:text-sky-700 hover:underline">ホーム</a>
      <span aria-hidden="true">/</span>
      <span class="text-slate-900">{tool.shortTitle}</span>
    </nav>

    <header class="mb-6 rounded-2xl border border-slate-200 bg-white p-5 shadow-xs sm:p-6">
      <div class="flex flex-wrap items-center gap-2">
        <span class="rounded-full bg-sky-50 px-3 py-1 text-xs font-semibold text-sky-800 ring-1 ring-sky-200">
          {tool.categoryLabel}
        </span>
        <span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-50 px-3 py-1 text-xs font-semibold text-emerald-800 ring-1 ring-emerald-200">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
            <path d="m9 12 2 2 4-4" />
          </svg>
          完全ブラウザ完結・外部送信 0 bytes
        </span>
      </div>
      <h1 class="mt-3 text-2xl font-bold text-slate-900 sm:text-3xl">
        {tool.name}
      </h1>
      <p class="mt-2 text-sm leading-relaxed text-slate-600 sm:text-base">
        {tool.summary}
      </p>
    </header>

    <section aria-label="ツール操作パネル" class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm sm:p-6">
      <slot name="tool" />
      <p class="mt-5 rounded-lg border border-slate-200 bg-slate-50 px-4 py-3 text-xs leading-relaxed text-slate-600">
        免責事項：本ツールはお客様のブラウザ内だけで計算・変換処理を実行します。入力された文字列やファイルが当サイトおよび第三者のサーバーへ送信されることはありませんが、業務文書や公開データの送信前には必ずご自身で最終出力を目視確認してください。
      </p>
    </section>

    <article class="mt-10 space-y-8 rounded-2xl border border-slate-200 bg-white p-6 shadow-xs sm:p-8">
      <slot name="guide" />

      <section aria-labelledby="faq-heading" class="border-t border-slate-200 pt-8">
        <h2 id="faq-heading" class="text-xl font-bold text-slate-900">
          よくある質問（FAQ）
        </h2>
        <div class="mt-4 space-y-4">
          {
            faqs.map((faq) => (
              <div class="rounded-xl border border-slate-200 bg-slate-50/70 p-4">
                <h3 class="text-base font-bold text-slate-900">{faq.question}</h3>
                <p class="mt-2 text-sm leading-relaxed text-slate-700">
                  {faq.answer}
                </p>
              </div>
            ))
          }
        </div>
      </section>
    </article>

    {
      relatedTools.length > 0 && (
        <section aria-labelledby="related-tools-heading" class="mt-10">
          <h2 id="related-tools-heading" class="text-lg font-bold text-slate-900">
            あわせて使えるゼロ送信ローカルツール
          </h2>
          <div class="mt-4 grid gap-4 sm:grid-cols-3">
            {relatedTools.map((rel) => (
              <a
                href={`/tools/${rel.slug}/`}
                class="group rounded-xl border border-slate-200 bg-white p-4 shadow-xs transition hover:border-sky-300 hover:shadow-sm"
              >
                <span class="inline-block rounded-full bg-slate-100 px-2.5 py-0.5 text-xs font-semibold text-slate-700">
                  {rel.categoryLabel}
                </span>
                <h3 class="mt-2 text-sm font-bold text-slate-900 group-hover:text-sky-700">
                  {rel.shortTitle}
                </h3>
                <p class="mt-1.5 text-xs leading-relaxed text-slate-600">
                  {rel.summary}
                </p>
              </a>
            ))}
          </div>
        </section>
      )
    }
  </div>
</BaseLayout>
